        <mxCell id="OsMowPCKIrXHRJ70eHsH-20" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;" value="Пример интерфейса" vertex="1">
          <mxGeometry height="30" width="190" x="1030" y="520" as="geometry" />
        </mxCell>
        <mxCell id="OsMowPCKIrXHRJ70eHsH-21" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;rounded=0;" value="========================================&lt;br&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;Blades of Eternity&lt;br&gt;========================================&lt;br&gt;&lt;br&gt;[1] &lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;Kael Stormblade&lt;br&gt;    &lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;HP: 120   Energy: 20&lt;br&gt;    &lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;Balanced fighter&lt;br&gt;&lt;br&gt;[2] &lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;Brakka Ironfist&lt;br&gt;    &lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;HP: 180   Energy: 15&lt;br&gt;    &lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;Tank, high survivability&lt;br&gt;&lt;br&gt;[3] &lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;Lyra Nightwhisper&lt;br&gt;    &lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;HP: 90    Energy: 25&lt;br&gt;    &lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;Mage, high damage&lt;br&gt;&lt;br&gt;----------------------------------------&lt;br&gt;Enter hero number:&lt;br&gt;&lt;br&gt;&amp;gt;&lt;br&gt;&lt;br&gt;You choosen Kael Stormblade. &lt;br&gt;Press Enter to continue...&lt;br&gt;&lt;br&gt;(Очищение экрана)&lt;br&gt;&lt;br&gt;&lt;div&gt;========================================&lt;br&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;BATTLE START&lt;br&gt;========================================&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;Kael Stormblade&lt;br&gt;HP: 120/120   Energy: 20/20&lt;br&gt;&lt;br&gt;Enemies:&lt;br&gt;[1] Goblin        HP: 20&lt;br&gt;[2] Skeleton      HP: 25&lt;br&gt;[3] Orc           HP: 50&lt;br&gt;&lt;br&gt;----------------------------------------&lt;br&gt;&lt;br&gt;Choose action:&lt;br&gt;1. Attack&lt;br&gt;2. Defense&lt;br&gt;3. Heal&lt;br&gt;4. End turn&lt;br&gt;&lt;br&gt;&amp;gt;&amp;nbsp;&lt;br&gt;&lt;br&gt;Choose skill:&lt;br&gt;&lt;br&gt;1. Power Strike   (Cost: 5, Damage: 15)&lt;br&gt;2. Fire Slash     (Cost: 8, Damage: 22)&lt;br&gt;0. Back&lt;br&gt;&lt;br&gt;&amp;gt;&amp;nbsp;&lt;br&gt;&lt;br&gt;Choose target:&lt;br&gt;&lt;br&gt;[1] Goblin   HP: 20&lt;br&gt;[2] Skeleton HP: 25&lt;br&gt;[3] Orc      HP: 50&lt;br&gt;&lt;br&gt;&amp;gt;&amp;nbsp;&lt;br&gt;&lt;br&gt;----------------------------------------&lt;br&gt;Kael uses Power Strike!&lt;br&gt;&lt;br&gt;Goblin takes 15 damage!&lt;br&gt;Goblin HP: 5&lt;br&gt;&lt;br&gt;----------------------------------------&lt;br&gt;&lt;br&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;Kael Stormblade&lt;br&gt;HP: 120/120 Energy: 20/20&lt;br&gt;&lt;br&gt;Enemies:&lt;br&gt;[1] Goblin HP: 20&lt;br&gt;[2] Skeleton HP: 25&lt;br&gt;[3] Orc HP: 50&lt;br&gt;&lt;br&gt;----------------------------------------&lt;br&gt;&lt;br&gt;Choose action:&lt;br&gt;1. Attack&lt;br&gt;2. Defense&lt;br&gt;3. Heal&lt;br&gt;4. End turn&lt;br&gt;&lt;br&gt;&amp;gt;&amp;nbsp;&lt;br&gt;&lt;br&gt;(Продолжение хода игрока)&lt;br&gt;&lt;br&gt;========================================&lt;br&gt;&lt;br&gt;Enemies turn...&lt;br&gt;&lt;br&gt;Goblin attacks Kael!&lt;br&gt;Damage: 3&lt;br&gt;&lt;br&gt;Skeleton attacks Kael!&lt;br&gt;Damage: 6&lt;br&gt;&lt;br&gt;Ork attacks Kael!&lt;br&gt;Damage: 10&lt;br&gt;&lt;br&gt;----------------------------------------&lt;br&gt;Kael HP: 101/120&lt;br&gt;&lt;br&gt;========================================&lt;br&gt;&lt;br&gt;(Продолжение боя)&lt;br&gt;&lt;br&gt;========================================&lt;br&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;&lt;/span&gt;VICTORY!&lt;br&gt;========================================&lt;br&gt;&lt;br&gt;Rewards:&lt;br&gt;+ 100 XP&lt;br&gt;&lt;br&gt;Press Enter to continue...&lt;br&gt;&lt;br&gt;(Очищение экрана)&lt;br&gt;&lt;br&gt;========================================&lt;br&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;&lt;/span&gt;Level up!&lt;br&gt;========================================&lt;br&gt;&lt;br&gt;Choose your upgrade:&lt;br&gt;&lt;br&gt;[1] Learn New Skill&lt;br&gt;[2] Upgrade Existing Skill&lt;br&gt;[3] Improve Stats&lt;br&gt;&lt;br&gt;----------------------------------------&lt;br&gt;&amp;gt;&lt;br&gt;&lt;br&gt;(Все варианты выбора)&lt;br&gt;&lt;br&gt;Choose a new skill:&lt;br&gt;&lt;br&gt;[1] &lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;Power Strike&lt;br&gt;    &lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;Type: Attack&lt;br&gt;    &lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;Cost: 5&lt;br&gt;    &lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;Power: 15&lt;br&gt;&lt;br&gt;[2] &lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;Iron Shield&lt;br&gt;    &lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;Type: Defense&lt;br&gt;    &lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;Cost: 7&lt;br&gt;    &lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;Power: 20&lt;br&gt;&lt;br&gt;[3] &lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;Healing Light&lt;br&gt;    &lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;Type: Heal&lt;br&gt;    &lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;Cost: 11&lt;br&gt;    &lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;Power: 32&lt;br&gt;&lt;br&gt;----------------------------------------&lt;br&gt;&amp;gt;&amp;nbsp;&amp;nbsp;&lt;br&gt;&lt;br&gt;&lt;br&gt;You learned: Healing Light!&lt;br&gt;&lt;br&gt;Choose a skill to upgrade:&lt;br&gt;&lt;br&gt;[1] Power Strike     (Damage: 15 → 20)&lt;br&gt;[2] Iron Shield      (Block: 18 → 24)&lt;br&gt;[3] Healing Light    (Heal: 20 → 26)&lt;br&gt;&lt;br&gt;----------------------------------------&lt;br&gt;&amp;gt;&amp;nbsp;&lt;br&gt;&lt;br&gt;Power Strike upgraded!&lt;br&gt;&lt;br&gt;&lt;br&gt;Improve your stats:&lt;br&gt;&lt;br&gt;[1] +30 Max HP&lt;br&gt;[2] +10 Max Energy&lt;br&gt;&lt;br&gt;----------------------------------------&lt;br&gt;&amp;gt;&amp;nbsp;&lt;br&gt;&lt;br&gt;Max HP increased!&lt;br&gt;&lt;br&gt;----------------------------------------&lt;br&gt;&lt;br&gt;Press Enter to enter next room...&lt;br&gt;&lt;br&gt;(После этого начинаеться бой)&lt;/div&gt;" vertex="1">
          <mxGeometry height="2730" width="435" x="950" y="550" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
